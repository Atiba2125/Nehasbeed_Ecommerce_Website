@model List<NehasBeed.Models.ApplicationUser>
@{
    ViewData["Title"] = "Users";
    ViewData["PageTitle"] = "Users";
    string search = ViewBag.Search ?? "";
}

@if (TempData["Success"] != null)
{
  <div style="background:rgba(39,174,96,0.1);border:1px solid rgba(39,174,96,0.3);border-radius:10px;padding:14px 20px;margin-bottom:20px;font-size:0.88rem;color:#1e8449;display:flex;align-items:center;gap:10px;">
    <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
  </div>
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:16px;">
  <div>
    <h1 style="font-family:var(--font-heading);font-size:1.8rem;font-weight:400;font-style:italic;">Users</h1>
    <p style="font-size:0.82rem;color:var(--mid);margin-top:4px;">@Model.Count registered users</p>
  </div>
  <a href="/Admin/CreateUser" style="display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:#fff;font-size:0.82rem;font-weight:500;padding:10px 22px;border-radius:var(--r-md);text-decoration:none;">
    <i class="fa-solid fa-user-plus"></i> Add User
  </a>
</div>



@* Users Table *@
<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-sm);overflow:hidden;">
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr>
        @foreach (var h in new[] { "User", "Email", "Date Registered", "Actions" })
        {
          <th style="padding:14px 20px;font-size:0.67rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--mid);background:#f9f8f5;border-bottom:1px solid var(--border);text-align:left;">@h</th>
        }
      </tr>
    </thead>
    <tbody>
      @if (Model.Count == 0)
      {
        <tr><td colspan="4" style="padding:48px;text-align:center;color:var(--mid);">No users found.</td></tr>
      }
      @foreach (var user in Model)
      {
        <tr onmouseover="this.querySelectorAll('td').forEach(t=>t.style.background='#fcfbf8')" onmouseout="this.querySelectorAll('td').forEach(t=>t.style.background='')">
          <td style="padding:16px 20px;border-bottom:1px solid #f0ede8;">
            <div style="display:flex;align-items:center;gap:14px;">
              <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#7b5ea7,#c9a96e);display:flex;align-items:center;justify-content:center;color:#fff;font-family:var(--font-heading);font-size:1rem;font-weight:600;flex-shrink:0;">
                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
              </div>
              <span style="font-size:0.88rem;font-weight:500;">@(string.IsNullOrEmpty(user.FullName) ? "—" : user.FullName)</span>
            </div>
          </td>
          <td style="padding:16px 20px;border-bottom:1px solid #f0ede8;font-size:0.85rem;">@user.Email</td>
          <td style="padding:16px 20px;border-bottom:1px solid #f0ede8;font-size:0.82rem;color:var(--mid);">@user.CreatedAt.ToString("dd MMM yyyy")</td>
          <td style="padding:16px 20px;border-bottom:1px solid #f0ede8;">
            <form method="post" action="/Admin/DeleteUser" style="display:inline;" onsubmit="return confirm('Remove user @user.Email?')">
              @Html.AntiForgeryToken()
              <input type="hidden" name="userId" value="@user.Id">
              <button type="submit" style="padding:6px 14px;border:1px solid rgba(192,57,43,0.3);border-radius:8px;font-size:0.75rem;color:var(--error);background:rgba(192,57,43,0.07);cursor:pointer;display:inline-flex;align-items:center;gap:5px;">
                <i class="fa-solid fa-user-minus"></i> Remove
              </button>
            </form>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
