@model NehasBeed.Models.Product
@{
    ViewData["Title"] = "Edit Product";
    ViewData["PageTitle"] = "Edit Product";
}

<div style="max-width:700px;">
  <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px;">
    <a href="/Admin/Products" style="width:38px;height:38px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--ink);text-decoration:none;">
      <i class="fa-solid fa-arrow-left"></i>
    </a>
    <h1 style="font-family:var(--font-heading);font-size:1.8rem;font-weight:400;font-style:italic;">Edit — @Model.Name</h1>
  </div>

  <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:36px;box-shadow:var(--shadow-sm);">
    <form method="post" action="/Admin/EditProduct" enctype="multipart/form-data">
      @Html.AntiForgeryToken()
      <input type="hidden" name="Id" value="@Model.Id">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
        <div class="form-group">
          <label class="form-label">Product Name *</label>
          <input type="text" name="Name" class="form-control" value="@Model.Name" required>
        </div>
        <div class="form-group">
          <label class="form-label">Category *</label>
          <select name="Category" class="form-control" required>
            <option value="Mobile Accessories" selected="@(Model.Category=="Mobile Accessories")">Mobile Accessories</option>
            <option value="Suncatchers"        selected="@(Model.Category=="Suncatchers")">Suncatchers</option>
            <option value="Beaded bags"         selected="@(Model.Category=="Beaded bags")">Beaded Bags</option>
            <option value="Chain"               selected="@(Model.Category=="Chain")">Chain</option>
            <option value="Necklaces"           selected="@(Model.Category=="Necklaces")">Necklaces</option>
            <option value="Earings"             selected="@(Model.Category=="Earings")">Earings</option>
            <option value="Rings"               selected="@(Model.Category=="Rings")">Rings</option>
            <option value="Hair Accessories"    selected="@(Model.Category=="Hair Accessories")">Hair Accessories</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Price (£) *</label>
          <input type="number" name="Price" class="form-control" step="0.01" value="@Model.Price" required>
        </div>
        <div class="form-group">
          <label class="form-label">Original Price (£)</label>
          <input type="number" name="OriginalPrice" class="form-control" step="0.01" value="@Model.OriginalPrice">
        </div>
        <div class="form-group">
          <label class="form-label">Badge</label>
          <select name="Badge" class="form-control">
            <option value=""           selected="@(Model.Badge==null)">— None —</option>
            <option value="Bestseller" selected="@(Model.Badge=="Bestseller")">Bestseller</option>
            <option value="New"        selected="@(Model.Badge=="New")">New</option>
            <option value="Sale"       selected="@(Model.Badge=="Sale")">Sale</option>
            <option value="Limited"    selected="@(Model.Badge=="Limited")">Limited</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Rating (0–5)</label>
          <input type="number" name="Rating" class="form-control" step="0.1" min="0" max="5" value="@Model.Rating">
        </div>
        <div class="form-group">
          <label class="form-label">Reviews Count</label>
          <input type="number" name="Reviews" class="form-control" min="0" value="@Model.Reviews">
        </div>
        <div class="form-group">
          <label class="form-label">Stock Quantity</label>
          <input type="number" name="StockQuantity" class="form-control" min="0" value="@Model.StockQuantity">
          <div style="font-size:0.72rem;color:var(--mid);margin-top:4px;">Current: <strong>@Model.StockQuantity</strong> units — Set to 0 to mark Sold Out</div>
        </div>
      </div>
      <div class="form-group" style="margin-bottom:20px;">
        <label class="form-label">Description</label>
        <textarea name="Description" class="form-control" rows="4">@Model.Description</textarea>
      </div>
      <div class="form-group" style="margin-bottom:28px;">
        <label class="form-label">Product Image (leave blank to keep current)</label>
        <div style="display:flex;gap:16px;align-items:center;margin-bottom:10px;">
          <img src="~/@Model.Image" style="width:80px;height:96px;object-fit:cover;border-radius:8px;border:1px solid var(--border);" id="current-img">
          <div style="font-size:0.82rem;color:var(--mid);">Current image</div>
        </div>
        <input type="file" name="imageFile" class="form-control" accept="image/*" id="img-upload">
        <img id="img-preview" src="" style="display:none;width:80px;height:96px;object-fit:cover;border-radius:8px;border:1px solid var(--border);margin-top:10px;">
      </div>
      <div style="display:flex;gap:12px;">
        <button type="submit" style="display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:#fff;font-size:0.85rem;font-weight:500;padding:11px 28px;border-radius:var(--r-md);border:none;cursor:pointer;">
          <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>
        <a href="/Admin/Products" style="display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--ink);font-size:0.85rem;padding:11px 20px;border-radius:var(--r-md);border:1px solid var(--border);text-decoration:none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

@section ExtraJs {
<script>
  document.getElementById('img-upload').addEventListener('change', function () {
    const file = this.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = e => { const p = document.getElementById('img-preview'); p.src = e.target.result; p.style.display = 'block'; };
      reader.readAsDataURL(file);
    }
  });
</script>
}
