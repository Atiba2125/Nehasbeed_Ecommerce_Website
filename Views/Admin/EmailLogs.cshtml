@model List<string>
@{
    ViewData["Title"] = "Email Logs";
    ViewData["PageTitle"] = "Email Logs";
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
  <div>
    <h1 style="font-family:var(--font-heading);font-size:1.8rem;font-weight:400;font-style:italic;">Transactional Email Logs</h1>
    <p style="font-size:0.82rem;color:var(--mid);margin-top:4px;">Mock emails and PDF invoices generated by the system</p>
  </div>
</div>

<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-sm);padding:24px;">
  <p style="font-size:0.85rem;color:var(--mid);margin-bottom:20px;line-height:1.6;">
    Since this is a simulated offline environment, actual SMTP dispatch is bypassed. Instead, all order placement, confirmation, cancellation, and dispatch emails are rendered as complete HTML files and saved to the <code>wwwroot/sent_emails/</code> directory along with their generated invoice PDFs.
  </p>

  @if (Model.Count == 0)
  {
    <div style="text-align:center;padding:48px;color:var(--mid);border:1px dashed var(--border);border-radius:var(--r-md);">
      <i class="fa-regular fa-envelope-open" style="font-size:2rem;margin-bottom:12px;color:var(--border);"></i>
      <p style="font-size:0.9rem;">No emails have been simulated yet. Try placing an order or confirming one!</p>
    </div>
  }
  else
  {
    <div style="display:flex;flex-direction:column;gap:12px;">
      @foreach (var email in Model)
      {
        var parts = email.Split('_');
        var invoice = parts.Length > 0 ? parts[0] : "Order";
        var type = parts.Length > 1 ? parts[1] : "Email";
        
        var badgeColor = type switch {
          "placed" => "#d68910",
          "confirmed" => "#27ae60",
          "dispatched" => "#3498db",
          _ => "#7f8c8d"
        };
        var badgeBg = type switch {
          "placed" => "rgba(243,156,18,0.12)",
          "confirmed" => "rgba(39,174,96,0.12)",
          "dispatched" => "rgba(52,152,219,0.12)",
          _ => "rgba(127,140,141,0.12)"
        };

        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border:1px solid var(--border);border-radius:var(--r-md);background:#fcfbf8;transition:all 0.2s;"
             onmouseover="this.style.borderColor='var(--gold)';this.style.boxShadow='var(--shadow-sm)';"
             onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='none';">
          <div style="display:flex;align-items:center;gap:16px;">
            <div style="width:40px;height:40px;border-radius:50%;background:@badgeBg;color:@badgeColor;display:flex;align-items:center;justify-content:center;font-size:1.1rem;">
              <i class="fa-regular fa-envelope"></i>
            </div>
            <div>
              <div style="font-weight:600;font-size:0.9rem;color:var(--taupe);">Invoice: @invoice</div>
              <div style="font-size:0.75rem;color:var(--mid);margin-top:2px;">Filename: @email</div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:0.65rem;font-weight:700;text-transform:uppercase;padding:4px 10px;border-radius:99px;color:@badgeColor;background:@badgeBg;">
              @type
            </span>
            <a href="/Admin/ViewEmailLog?fileName=@email" target="_blank" class="btn btn-secondary btn-xs" style="text-decoration:none;padding:6px 14px;font-size:0.75rem;">
              <i class="fa-regular fa-eye"></i> View Email
            </a>
            @if (type == "placed" || type == "confirmed")
            {
              <a href="/sent_emails/@(invoice)_@(type)_invoice.pdf" target="_blank" class="btn btn-secondary btn-xs" style="text-decoration:none;padding:6px 14px;font-size:0.75rem;background:#fff;border-color:#3498db;color:#3498db;">
                <i class="fa-solid fa-file-pdf"></i> View PDF
              </a>
            }
          </div>
        </div>
      }
    </div>
  }
</div>
