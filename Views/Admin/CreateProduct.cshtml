@model NehasBeed.Models.Product
@{
    ViewData["Title"] = "Add Product";
    ViewData["PageTitle"] = "Add Product";
}

<div style="max-width:700px;">
  <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px;">
    <a href="/Admin/Products" style="width:38px;height:38px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--ink);text-decoration:none;font-size:0.9rem;">
      <i class="fa-solid fa-arrow-left"></i>
    </a>
    <h1 style="font-family:var(--font-heading);font-size:1.8rem;font-weight:400;font-style:italic;">Add New Product</h1>
  </div>

  <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:36px;box-shadow:var(--shadow-sm);">
    <form method="post" action="/Admin/CreateProduct" enctype="multipart/form-data">
      @Html.AntiForgeryToken()
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
        <div class="form-group">
          <label class="form-label">Product Name *</label>
          <input type="text" name="Name" class="form-control" placeholder="Mosaic Tote" required>
        </div>
        <div class="form-group">
          <label class="form-label">Category *</label>
          <select name="Category" class="form-control" required>
            <option value="">— Select —</option>
            <option value="Mobile Accessories">Mobile Accessories</option>
            <option value="Suncatchers">Suncatchers</option>
            <option value="Beaded bags">Beaded Bags</option>
            <option value="Chain">Chain</option>
            <option value="Necklaces">Necklaces</option>
            <option value="Earings">Earings</option>
            <option value="Rings">Rings</option>
            <option value="Hair Accessories">Hair Accessories</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Price (£) *</label>
          <input type="number" name="Price" class="form-control" step="0.01" min="0" placeholder="185.00" required>
        </div>
        <div class="form-group">
          <label class="form-label">Original Price (£) — optional</label>
          <input type="number" name="OriginalPrice" class="form-control" step="0.01" min="0" placeholder="220.00">
        </div>
        <div class="form-group">
          <label class="form-label">Badge</label>
          <select name="Badge" class="form-control">
            <option value="">— None —</option>
            <option value="Bestseller">Bestseller</option>
            <option value="New">New</option>
            <option value="Sale">Sale</option>
            <option value="Limited">Limited</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Rating (0–5)</label>
          <input type="number" name="Rating" class="form-control" step="0.1" min="0" max="5" value="0">
        </div>
        <div class="form-group">
          <label class="form-label">Reviews Count</label>
          <input type="number" name="Reviews" class="form-control" min="0" value="0">
        </div>
        <div class="form-group">
          <label class="form-label">Stock Quantity *</label>
          <input type="number" name="StockQuantity" class="form-control" min="0" value="10" placeholder="e.g. 20" required>
          <div style="font-size:0.72rem;color:var(--mid);margin-top:4px;">Set to 0 to mark as Sold Out immediately</div>
        </div>
      </div>
      <div class="form-group" style="margin-bottom:20px;">
        <label class="form-label">Description</label>
        <textarea name="Description" class="form-control" rows="4" placeholder="Enter product description..."></textarea>
      </div>
      <div class="form-group" style="margin-bottom:28px;">
        <label class="form-label">Product Image</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" id="img-upload">
        <div style="margin-top:12px;">
          <img id="img-preview" src="" style="display:none;width:100px;height:120px;object-fit:cover;border-radius:8px;border:1px solid var(--border);">
        </div>
      </div>
      <div style="display:flex;gap:12px;">
        <button type="submit" style="display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:#fff;font-size:0.85rem;font-weight:500;padding:11px 28px;border-radius:var(--r-md);border:none;cursor:pointer;">
          <i class="fa-solid fa-plus"></i> Add Product
        </button>
        <a href="/Admin/Products" style="display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--ink);font-size:0.85rem;padding:11px 20px;border-radius:var(--r-md);border:1px solid var(--border);text-decoration:none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

@section ExtraJs {
<script>
  document.getElementById('img-upload').addEventListener('change', function () {
    const file = this.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = e => { const p = document.getElementById('img-preview'); p.src = e.target.result; p.style.display = 'block'; };
      reader.readAsDataURL(file);
    }
  });
</script>
}
