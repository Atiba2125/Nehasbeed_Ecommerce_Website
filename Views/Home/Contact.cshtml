@{
    ViewData["Title"] = "Contact Us – NEHAS BEED";
    ViewData["MetaDescription"] = "Reach out to NEHAS BEED support for custom handcrafted product orders, inquiries, or customer support.";
}

@section ExtraCss {
<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    padding: 60px 0 80px;
    align-items: start;
  }
  .contact-info h2 {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 300;
    margin-bottom: 20px;
  }
  .contact-info p {
    color: var(--mid);
    line-height: 1.8;
    margin-bottom: 30px;
    font-size: 0.95rem;
  }
  .info-item {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
    align-items: flex-start;
  }
  .info-icon {
    font-size: 1.2rem;
    color: var(--taupe);
    background: var(--bg-dark);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .info-text h4 {
    font-family: var(--font-btn);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .info-text p {
    margin-bottom: 0;
    font-size: 0.88rem;
    color: var(--mid);
  }
  .contact-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 40px;
    box-shadow: var(--shadow-sm);
  }
  .contact-card h3 {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-style: italic;
    font-weight: 300;
    margin-bottom: 24px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-label {
    display: block;
    font-family: var(--font-btn);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mid);
    margin-bottom: 8px;
    font-weight: 600;
  }
  .alert-success {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
    padding: 16px 20px;
    border-radius: var(--r-sm);
    border: 1px solid rgba(39, 174, 96, 0.2);
    margin-bottom: 24px;
    font-size: 0.88rem;
    font-weight: 500;
  }
  @@media(max-width:768px) {
    .contact-layout { grid-template-columns: 1fr; gap: 40px; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>
}

<div class="page-header">
  <div class="container" style="text-align:center;">
    <div class="breadcrumb" style="justify-content:center">
      <a href="/">Home</a><span>/</span><span>Contact Us</span>
    </div>
    <h1 class="section-title animate-fade-up">Get in Touch</h1>
    <p style="color:var(--mid);margin-top:8px;">We are here to assist with custom orders, inquiries, or support</p>
  </div>
</div>

<div class="container">
  <div class="contact-layout">
    
    @* Left Info Column *@
    <div class="contact-info reveal">
      <h2>Let's Start a Conversation</h2>
      <p>
        Whether you are interested in a bespoke beaded design, need help with an order, or just want to learn more about our process, our dedicated concierge team is ready to connect.
      </p>
      
      <div class="info-item">
        <div class="info-icon"><i class="fa-solid fa-location-dot"></i></div>
        <div class="info-text">
          <h4>Our Atelier</h4>
          <p>42 Belgrave Square, Belgravia<br>London, SW1X 8PG, United Kingdom</p>
        </div>
      </div>
      
      <div class="info-item">
        <div class="info-icon"><i class="fa-solid fa-envelope"></i></div>
        <div class="info-text">
          <h4>Atelier Inquiries</h4>
          <p>atelier@nehasbeed.com<br>customorders@nehasbeed.com</p>
        </div>
      </div>
      
      <div class="info-item">
        <div class="info-icon"><i class="fa-solid fa-phone"></i></div>
        <div class="info-text">
          <h4>Customer Care</h4>
          <p>+44 (0) 20 7946 0958<br>Mon – Fri: 9:00 AM – 6:00 PM GMT</p>
        </div>
      </div>
    </div>
    
    @* Right Form Column *@
    <div class="contact-card reveal delay-200">
      <h3>Send a Message</h3>
      
      @if (TempData["ContactSuccess"] != null)
      {
        <div class="alert-success">
          <i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i> @TempData["ContactSuccess"]
        </div>
      }
      
      <form method="post" action="/Home/SubmitContact">
        @Html.AntiForgeryToken()
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name *</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Audrey Hepburn" required>
          </div>
          <div class="form-group">
            <label class="form-label">Email Address *</label>
            <input type="email" name="email" class="form-control" placeholder="e.g. audrey@example.com" required>
          </div>
        </div>
        
        <div class="form-group">
          <label class="form-label">Subject *</label>
          <input type="text" name="subject" class="form-control" placeholder="e.g. Custom Beaded Handbag Inquiry" required>
        </div>
        
        <div class="form-group">
          <label class="form-label">Message *</label>
          <textarea name="message" class="form-control" style="height:140px;resize:vertical;" placeholder="Please detail your request..." required></textarea>
        </div>
        
        <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:10px;">
          Send Message
        </button>
      </form>
    </div>
    
  </div>
</div>
