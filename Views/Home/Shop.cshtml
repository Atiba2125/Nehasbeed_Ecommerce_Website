@model List<NehasBeed.Models.Product>
@{
    ViewData["Title"] = "Shop All – NEHAS BEED";
    ViewData["MetaDescription"] = "Browse our full collection of handcrafted beaded bags, chains, necklaces and accessories.";
    var searchQuery = ViewBag.Search as string;
    var catFilter   = ViewBag.Cat as string;
}

@section ExtraCss {
<style>
  .shop-layout { display:grid; grid-template-columns:260px 1fr; gap:40px; padding:48px 0; align-items:start; }
  .filter-sidebar { background:var(--white); border-radius:var(--r-lg); padding:28px; border:1px solid var(--border); position:sticky; top:calc(var(--header-h) + 24px); }
  .filter-title { font-family:var(--font-btn); font-size:0.68rem; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:var(--ink); margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid var(--border); }
  .filter-group { margin-bottom:24px; }
  .filter-option { display:flex; align-items:center; gap:10px; padding:7px 0; cursor:pointer; font-size:0.88rem; transition:color var(--fast); }
  .filter-option:hover { color:var(--taupe); }
  .filter-option input[type=checkbox], .filter-option input[type=radio] { accent-color:var(--taupe); width:15px; height:15px; cursor:pointer; }
  .price-range { display:flex; gap:10px; }
  .price-input { width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:var(--r-sm); font-size:0.82rem; text-align:center; }
  .sort-bar { display:flex; align-items:center; justify-content:space-between; margin-bottom:28px; flex-wrap:wrap; gap:16px; }
  .sort-bar-left { font-size:0.88rem; color:var(--mid); }
  .sort-select { padding:9px 36px 9px 14px; border:1px solid var(--border); border-radius:var(--r-sm); font-size:0.82rem; font-family:var(--font-btn); background:var(--white); }
  @@media(max-width:900px){ .shop-layout{grid-template-columns:1fr;} .filter-sidebar{position:static;} }
  @@media(max-width:600px){ #products-grid{ grid-template-columns:1fr 1fr!important; gap:12px!important; } }
</style>
}

@* Page Header *@
<div class="page-header">
  <div class="container">
    <div class="breadcrumb" style="justify-content:center">
      <a href="/">Home</a><span>/</span>
      @if (!string.IsNullOrEmpty(searchQuery))
      {
        <span>Search Results</span>
      }
      else if (!string.IsNullOrEmpty(catFilter) && catFilter != "all")
      {
        <span>@catFilter</span>
      }
      else
      {
        <span>All Products</span>
      }
    </div>
    @if (!string.IsNullOrEmpty(searchQuery))
    {
      <h1 class="section-title animate-fade-up">Search Results</h1>
      <p style="color:var(--mid);margin-top:8px;">Showing results for &ldquo;<strong style="color:var(--taupe);">@searchQuery</strong>&rdquo; &mdash; @Model.Count product@(Model.Count != 1 ? "s" : "") found</p>
    }
    else if (!string.IsNullOrEmpty(catFilter) && catFilter != "all")
    {
      <h1 class="section-title animate-fade-up">@catFilter</h1>
      <p style="color:var(--mid);margin-top:8px;">Handcrafted with love, one bead at a time</p>
    }
    else
    {
      <h1 class="section-title animate-fade-up">Our Collection</h1>
      <p style="color:var(--mid);margin-top:8px;">Handcrafted with love, one bead at a time</p>
    }
  </div>
</div>

<div class="container">
  <div class="shop-layout">
    @* Sidebar Filters *@
    <aside class="filter-sidebar">
      <div class="filter-group">
        <div class="filter-title">Categories</div>
        <label class="filter-option"><input type="radio" name="cat" value="all" checked onchange="applyFilters()"> All Products</label>
        <label class="filter-option"><input type="radio" name="cat" value="Mobile Accessories" onchange="applyFilters()"> Mobile Accessories</label>
        <label class="filter-option"><input type="radio" name="cat" value="Suncatchers" onchange="applyFilters()"> Suncatchers</label>
        <label class="filter-option"><input type="radio" name="cat" value="Beaded bags" onchange="applyFilters()"> Beaded Bags</label>
        <label class="filter-option"><input type="radio" name="cat" value="Chain" onchange="applyFilters()"> Chain</label>
        <label class="filter-option"><input type="radio" name="cat" value="Necklaces" onchange="applyFilters()"> Necklaces</label>
        <label class="filter-option"><input type="radio" name="cat" value="Earings" onchange="applyFilters()"> Earings</label>
        <label class="filter-option"><input type="radio" name="cat" value="Rings" onchange="applyFilters()"> Rings</label>
        <label class="filter-option"><input type="radio" name="cat" value="Hair Accessories" onchange="applyFilters()"> Hair Accessories</label>
      </div>
      <div class="filter-group">
        <div class="filter-title">Price Range</div>
        <div class="price-range">
          <input type="number" id="price-min" class="price-input" placeholder="Min £" value="0" onchange="applyFilters()">
          <input type="number" id="price-max" class="price-input" placeholder="Max £" value="500" onchange="applyFilters()">
        </div>
      </div>
      <div class="filter-group">
        <div class="filter-title">Filter By</div>
        <label class="filter-option"><input type="checkbox" id="f-sale" onchange="applyFilters()"> On Sale</label>
        <label class="filter-option"><input type="checkbox" id="f-new" onchange="applyFilters()"> New Arrivals</label>
        <label class="filter-option"><input type="checkbox" id="f-best" onchange="applyFilters()"> Bestsellers</label>
      </div>
      <button class="btn btn-secondary btn-full btn-sm" onclick="clearFilters()">Clear All Filters</button>
    </aside>

    @* Products Area *@
    <div>
      <div class="sort-bar">
        <span class="sort-bar-left" id="product-count">Showing <b>@Model.Count</b> products</span>
        <select class="sort-select" id="sort-select" onchange="applyFilters()">
          <option value="default">Featured</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="rating">Top Rated</option>
        </select>
      </div>
      <div class="products-grid" id="products-grid" style="grid-template-columns:repeat(3,1fr)">
        @foreach (var product in Model)
        {
            bool isSoldOut = product.StockQuantity <= 0;
            bool isLowStock = !isSoldOut && product.StockQuantity <= 5;
            <article class="product-card" data-id="@product.Id" data-category="@product.Category" data-price="@product.Price" data-badge="@product.Badge">
              <div class="product-card-img-wrap">
                <img src="~/@product.Image" alt="@product.Name" class="product-card-img @(isSoldOut ? "sold-out-img" : "")" loading="lazy">
                @if (isSoldOut)
                {
                  <span class="sold-out-badge">Sold Out</span>
                }
                else if (product.Badge != null)
                {
                  <span class="product-card-badge @product.Badge.ToLower().Replace(" ", "-")">@product.Badge</span>
                }
                <div class="product-card-actions">
                  <button class="product-action-btn" onclick="toggleWish(this)" title="Wishlist">
                    <i class="fa-regular fa-heart"></i>
                  </button>
                  <a href="/Home/Product/@product.Id" class="product-action-btn" title="View Product">
                    <i class="fa-regular fa-eye"></i>
                  </a>
                </div>
                @if (isSoldOut)
                {
                  <div class="product-card-quick-add btn-sold-out" style="cursor:not-allowed;opacity:0.75;">
                    <i class="fa-solid fa-ban" style="font-size:0.8rem;"></i> Sold Out
                  </div>
                }
                else
                {
                  <button type="button" class="product-card-quick-add" style="border:none;cursor:pointer;width:100%;text-align:center;" onclick="event.preventDefault(); addToCartDirect(@product.Id, '@Html.Raw(product.Name.Replace("'", "\\'"))', @product.Price, '@product.Image')">Add to Cart</button>
                }
              </div>
            <div class="product-card-info">
              <span class="product-card-category">@product.Category</span>
              <a href="/Home/Product/@product.Id" class="product-card-name">@product.Name</a>
              <div class="product-card-rating">
                <span class="stars">@product.GetStars()</span>
                <span class="review-count">(@product.Reviews)</span>
              </div>
              <div class="product-card-price">
                <span class="price-current">£@product.Price.ToString("F2")</span>
                @if (product.OriginalPrice.HasValue)
                {
                  <span class="price-original">£@product.OriginalPrice.Value.ToString("F2")</span>
                }
              </div>
              @if (isSoldOut)
              {
                <div style="font-size:0.7rem;color:#c0392b;font-weight:600;margin-top:4px;display:flex;align-items:center;gap:4px;">
                  <i class="fa-solid fa-circle-xmark"></i> Out of Stock
                </div>
              }
              else if (isLowStock)
              {
                <div style="font-size:0.7rem;color:#d68910;font-weight:600;margin-top:4px;display:flex;align-items:center;gap:4px;">
                  <i class="fa-solid fa-fire-flame-curved"></i> Only @product.StockQuantity left!
                </div>
              }
              else
              {
                <div style="font-size:0.7rem;color:#27ae60;margin-top:4px;display:flex;align-items:center;gap:4px;">
                  <i class="fa-solid fa-circle-check"></i> @product.StockQuantity in stock
                </div>
              }
            </div>
          </article>
        }
        @if (!Model.Any())
        {
          <div style="grid-column:1/-1;text-align:center;padding:80px 20px;">
            <i class="fa-regular fa-face-sad-tear" style="font-size:3rem;color:var(--border);margin-bottom:20px;display:block;"></i>
            <h3 style="font-family:var(--font-display);font-size:1.6rem;margin-bottom:10px;">No Products Found</h3>
            @if (!string.IsNullOrEmpty(searchQuery))
            {
              <p style="color:var(--mid);margin-bottom:24px;">We couldn&rsquo;t find anything matching &ldquo;<strong>@searchQuery</strong>&rdquo;. Try a different keyword.</p>
            }
            else
            {
              <p style="color:var(--mid);margin-bottom:24px;">No products in this category yet. Check back soon!</p>
            }
            <a href="/Home/Shop" class="btn btn-primary">Browse All Products</a>
          </div>
        }
      </div>
      <div style="text-align:center;padding:40px 0 20px;">
        <p style="color:var(--mid);font-size:0.85rem;" id="showing-text">Showing all products</p>
      </div>
    </div>
  </div>
</div>

@section ExtraJs {
<script>
  const params = new URLSearchParams(window.location.search);
  const urlCat = params.get('cat') || 'all';
  const urlSearch = params.get('search') || '';
  document.querySelectorAll('input[name="cat"]').forEach(r => { if (r.value === urlCat) r.checked = true; });
  if (urlCat !== 'all') {
    const titles = { bags:'Beaded Bags', chains:'Chains', necklaces:'Necklaces', accessories:'Accessories' };
    document.getElementById('page-title').textContent = titles[urlCat] || 'Our Collection';
    document.getElementById('bread-cat').textContent = titles[urlCat] || 'Shop';
  }
  if (urlSearch) document.getElementById('page-title').textContent = `Search: "${urlSearch}"`;

  function applyFilters() {
    const cat = document.querySelector('input[name="cat"]:checked')?.value || 'all';
    const minP = parseFloat(document.getElementById('price-min').value) || 0;
    const maxP = parseFloat(document.getElementById('price-max').value) || 9999;
    const onSale = document.getElementById('f-sale').checked;
    const isNew = document.getElementById('f-new').checked;
    const isBest = document.getElementById('f-best').checked;
    let count = 0;
    document.querySelectorAll('#products-grid .product-card').forEach(card => {
      const cardCat = card.dataset.category;
      const price = parseFloat(card.dataset.price);
      const badge = (card.dataset.badge || '').toLowerCase();
      let show = (cat === 'all' || cardCat === cat) && price >= minP && price <= maxP;
      if (onSale && badge !== 'sale') show = false;
      if (isNew && badge !== 'new') show = false;
      if (isBest && badge !== 'bestseller') show = false;
      card.style.display = show ? '' : 'none';
      if (show) count++;
    });
    document.getElementById('product-count').innerHTML = `Showing <b>${count}</b> products`;
  }
  function clearFilters() {
    document.querySelector('input[name="cat"][value="all"]').checked = true;
    document.getElementById('price-min').value = 0;
    document.getElementById('price-max').value = 500;
    document.getElementById('f-sale').checked = false;
    document.getElementById('f-new').checked = false;
    document.getElementById('f-best').checked = false;
    applyFilters();
  }
  function toggleWish(btn) {
    btn.classList.toggle('wishlisted');
    btn.innerHTML = btn.classList.contains('wishlisted') ? '<i class="fa-solid fa-heart"></i>' : '<i class="fa-regular fa-heart"></i>';
  }
  if (urlCat !== 'all') { document.querySelector(`input[name="cat"][value="${urlCat}"]`).click(); }
</script>
}
