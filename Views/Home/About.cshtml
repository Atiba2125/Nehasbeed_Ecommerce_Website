@{
    ViewData["Title"] = "About Us – NEHAS BEED";
    ViewData["MetaDescription"] = "Learn about the heritage, dedication, and handmade artisan craftsmanship behind NEHAS BEED luxury beaded accessories.";
}

@section ExtraCss {
<style>
  .about-hero {
    position: relative;
    padding: 120px 0;
    text-align: center;
    background: linear-gradient(135deg, #111 0%, #1a1025 100%);
    color: var(--white);
  }
  .about-hero h1 {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-style: italic;
    font-weight: 300;
    margin-bottom: 16px;
    letter-spacing: 0.05em;
  }
  .about-hero p {
    font-size: 1rem;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-family: var(--font-btn);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    padding: 80px 0;
    align-items: center;
  }
  .about-image {
    width: 100%;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4/5;
    object-fit: cover;
  }
  .about-text h2 {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 300;
    margin-bottom: 24px;
    color: var(--ink);
  }
  .about-text p {
    color: var(--mid);
    line-height: 1.8;
    margin-bottom: 20px;
    font-size: 0.95rem;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
    border-top: 1px solid var(--border);
    padding-top: 40px;
  }
  .stat-num {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    color: var(--taupe);
    font-weight: 300;
  }
  .stat-lbl {
    font-family: var(--font-btn);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--mid);
    margin-top: 4px;
  }
  @@media(max-width:768px) {
    .about-grid { grid-template-columns: 1fr; gap: 40px; }
    .about-hero h1 { font-size: 2.6rem; }
  }
</style>
}

<section class="about-hero">
  <div class="container animate-fade-up">
    <p>Our Story</p>
    <h1>Crafted with Intention & Grace</h1>
  </div>
</section>

<div class="container">
  <div class="about-grid">
    <div class="reveal">
      <img src="~/images/bag-2.png" alt="Beaded Craftsmanship" class="about-image">
    </div>
    <div class="about-text reveal delay-200">
      <h2>The Art of Patience</h2>
      <p>
        NEHAS BEED was founded on a simple belief: that fashion should be a form of fine art. In a world of fast mass-production, we stand for the beauty of patience, intention, and heritage.
      </p>
      <p>
        Each of our signature luxury handbags is meticulously crafted by hand, bead by bead, using Japanese Miyuki seed beads known for their unparalleled precision and brilliant color retention. Every single piece represents between 40 and 120 hours of concentrated, skilled craftsmanship.
      </p>
      <p>
        We work closely with small groups of local artisans, preserving traditional techniques while bringing modern, elegant geometric patterns to life. When you carry a NEHAS BEED piece, you carry a story of dedicated labor, culture, and wearable luxury.
      </p>
      
      <div class="stat-grid">
        <div>
          <div class="stat-num">120+</div>
          <div class="stat-lbl">Hours per piece</div>
        </div>
        <div>
          <div class="stat-num">100%</div>
          <div class="stat-lbl">Handmade</div>
        </div>
        <div>
          <div class="stat-num">500+</div>
          <div class="stat-lbl">Unique Designs</div>
        </div>
      </div>
    </div>
  </div>
</div>
