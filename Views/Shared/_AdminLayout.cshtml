<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"] – NEHAS BEED Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  
  <style>
    /* Premium Admin Panel Stylesheet */
    :root {
      --ink: #111111;
      --ink-soft: #444444;
      --mid: #888888;
      --border: #e8e5e0;
      --bg: #f7f6f2;
      --bg-card: #ffffff;
      
      --taupe: #857870;
      --gold: #c9a96e;
      --gold-hover: #b8935a;
      
      --error: #c0392b;
      --success: #27ae60;
      --warning: #f39c12;
      --info: #3498db;
      
      --sidebar-w: 260px;
      
      --font-heading: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'Inter', sans-serif;
      
      --r-sm: 8px;
      --r-md: 12px;
      --r-lg: 16px;
      --r-xl: 24px;
      
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
      --shadow-lg: 0 12px 40px rgba(0,0,0,0.12);
      
      --transition: all 0.2s ease-in-out;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--bg);
      color: var(--ink);
      min-height: 100vh;
      display: flex;
    }

    a {
      text-decoration: none;
      color: inherit;
      transition: var(--transition);
    }

    button {
      cursor: pointer;
      background: none;
      border: none;
      font-family: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    /* Main Container Layout */
    .main {
      margin-left: var(--sidebar-w);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 100vh;
    }

    /* Sidebar Styles */
    .sidebar {
      width: var(--sidebar-w);
      height: 100vh;
      background: #0f0f0f;
      position: fixed;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      z-index: 100;
      overflow-y: auto;
      border-right: 1px solid rgba(255,255,255,0.04);
    }

    .sidebar-brand {
      padding: 28px 24px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .sidebar-brand-name {
      font-family: var(--font-heading);
      font-size: 1.5rem;
      font-weight: 500;
      color: #fff;
      letter-spacing: 0.04em;
    }

    .sidebar-brand-tag {
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-top: 2px;
    }

    .sidebar-user {
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .sidebar-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, #7b5ea7, var(--gold));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-size: 1.15rem;
      color: #fff;
      font-weight: 600;
      flex-shrink: 0;
    }

    .sidebar-user-name {
      font-size: 0.88rem;
      font-weight: 500;
      color: #fff;
      max-width: 140px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .sidebar-user-role {
      font-size: 0.68rem;
      color: var(--gold);
      margin-top: 2px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .sidebar-nav {
      padding: 16px 12px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .nav-section-label {
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.25);
      padding: 16px 12px 8px;
      font-weight: 500;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-radius: 10px;
      font-size: 0.855rem;
      color: rgba(255,255,255,0.55);
      transition: var(--transition);
      font-weight: 400;
      text-decoration: none;
    }

    .nav-link i {
      width: 18px;
      text-align: center;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    .nav-link:hover {
      background: rgba(255,255,255,0.06);
      color: #fff;
    }

    .nav-link.active {
      background: linear-gradient(135deg, rgba(201,169,110,0.18), rgba(201,169,110,0.06));
      color: var(--gold);
      border: 1px solid rgba(201,169,110,0.15);
    }

    .nav-link.active i {
      color: var(--gold);
    }

    .sidebar-bottom {
      padding: 12px 12px 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .nav-link-danger {
      color: rgba(192,57,43,0.7);
    }

    .nav-link-danger:hover {
      background: rgba(192,57,43,0.1);
      color: #e74c3c;
    }

    /* Topbar Styles */
    .topbar {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      padding: 0 40px;
      height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar-breadcrumb {
      font-size: 0.78rem;
      color: var(--mid);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .topbar-breadcrumb span {
      color: var(--ink);
      font-weight: 600;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .session-badge {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--success);
      background: rgba(39,174,96,0.08);
      border: 1px solid rgba(39,174,96,0.2);
      padding: 7px 14px;
      border-radius: 99px;
    }

    .session-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--success);
      animation: pulse 2s infinite;
    }

    @@keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .topbar-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--ink);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 9px 18px;
      border-radius: 9px;
      transition: opacity 0.18s;
      border: 1px solid transparent;
      text-decoration: none;
    }

    .topbar-btn:hover {
      opacity: 0.85;
    }

    /* Page Content Styles */
    .page-content {
      padding: 36px 40px;
      flex: 1;
    }

    /* Form Styles */
    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--mid);
      margin-bottom: 8px;
    }

    .form-control {
      width: 100%;
      padding: 11px 16px;
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      background-color: #fff;
      color: var(--ink);
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.18s ease-in-out;
    }

    .form-control:focus {
      border-color: var(--taupe);
    }

    /* Responsive adjustments */
    @@media(max-width: 768px) {
      .sidebar {
        display: none; /* simple hidden sidebar on mobile */
      }
      .main {
        margin-left: 0;
      }
      .topbar {
        padding: 0 20px;
      }
      .page-content {
        padding: 24px 20px;
      }
    }
  </style>
  @await RenderSectionAsync("ExtraCss", required: false)
</head>
<body>

  @await Html.PartialAsync("_Sidebar")

  <div class="main">
    <!-- Topbar -->
    <div class="topbar">
      <div class="topbar-breadcrumb">
        Admin / <span>@ViewData["PageTitle"]</span>
      </div>

      <!-- Global Search Bar inside Topbar -->
      <div style="flex: 1; max-width: 400px; margin: 0 32px; position: relative;" class="no-print">
        <form id="global-search-form" method="get" action="">
          <input type="text" id="global-search-input" name="search" placeholder="Search in this view..." value="@ViewBag.Search"
                 style="width: 100%; padding: 9px 16px 9px 38px; border: 1px solid var(--border); border-radius: 99px; font-size: 0.82rem; outline: none; background: var(--bg); transition: var(--transition);">
          <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--mid); font-size: 0.85rem;"></i>
        </form>
      </div>

      <div class="topbar-right">
        <div class="session-badge no-print">
          <div class="session-dot"></div> Active Session
        </div>

        <!-- Notification Bell Dropdown -->
        <div style="position: relative; display: inline-block;" class="no-print" id="admin-notif-container">
          <button id="admin-notif-btn" class="topbar-btn" style="position: relative; background: var(--bg-card); border: 1px solid var(--border); color: var(--ink); cursor: pointer; padding: 9px 12px; border-radius: 9px;">
            <i class="fa-solid fa-bell"></i>
            <span id="admin-notif-badge" style="position: absolute; top: -5px; right: -5px; background: var(--error); color: #fff; font-size: 0.62rem; font-weight: 700; width: 15px; height: 15px; border-radius: 50%; display: none; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.15);">0</span>
          </button>
          
          <div id="admin-notif-dropdown" style="position: absolute; right: 0; top: 42px; width: 300px; background: #fff; border: 1px solid var(--border); border-radius: var(--r-md); box-shadow: var(--shadow-lg); display: none; z-index: 1000; overflow: hidden; text-align: left;">
            <div style="padding: 10px 14px; border-bottom: 1px solid var(--border); font-weight: 600; font-size: 0.78rem; color: var(--ink); display: flex; justify-content: space-between; align-items: center;">
              <span>Store Notifications</span>
              <span id="admin-notif-count" style="font-size: 0.7rem; color: var(--mid); font-weight: normal;">0 alerts</span>
            </div>
            <div id="admin-notif-list" style="max-height: 250px; overflow-y: auto; font-size: 0.74rem; line-height: 1.4;">
              <!-- Populated by JS -->
            </div>
            <div style="padding: 8px; text-align: center; border-top: 1px solid var(--border); background: #faf9f7;">
              <a href="/Admin/Notifications" style="font-size: 0.72rem; font-weight: 600; color: var(--taupe); text-decoration: none;">Manage All Notifications</a>
            </div>
          </div>
        </div>

        <a href="/" class="topbar-btn no-print">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> View Store
        </a>
        <form method="post" action="/Account/Logout" style="margin: 0; display: inline-block;" class="no-print">
          @Html.AntiForgeryToken()
          <button type="submit" class="topbar-btn" style="background: rgba(192,57,43,0.1); color: var(--error); border: 1px solid rgba(192,57,43,0.25); cursor: pointer;">
            <i class="fa-solid fa-right-from-bracket"></i> Sign Out
          </button>
        </form>
      </div>
    </div>

    <!-- Page Content -->
    <div class="page-content">
      @RenderBody()
    </div>
  </div>

  <script src="~/js/admin.js" asp-append-version="true"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const searchForm = document.getElementById("global-search-form");
      const searchInput = document.getElementById("global-search-input");
      if (searchForm && searchInput) {
        const path = window.location.pathname.toLowerCase();
        if (path.includes("/admin/products")) {
          searchForm.action = "/Admin/Products";
          searchInput.placeholder = "Search products by name or category...";
        } else if (path.includes("/admin/orders")) {
          searchForm.action = "/Admin/Orders";
          searchInput.placeholder = "Search orders by invoice or customer...";
        } else if (path.includes("/admin/users")) {
          searchForm.action = "/Admin/Users";
          searchInput.placeholder = "Search users by name or email...";
        } else {
          // Default to products search if on Dashboard or other pages
          searchForm.action = "/Admin/Products";
          searchInput.placeholder = "Search products...";
        }
      }
    });

    // ── Admin Topbar Notifications JS ──
    document.addEventListener("DOMContentLoaded", function() {
      const btn = document.getElementById("admin-notif-btn");
      const dropdown = document.getElementById("admin-notif-dropdown");
      const badge = document.getElementById("admin-notif-badge");
      const countText = document.getElementById("admin-notif-count");
      const listEl = document.getElementById("admin-notif-list");

      let latestNotifId = 0;

      if (btn && dropdown) {
        // Toggle dropdown
        btn.addEventListener("click", function(e) {
          e.stopPropagation();
          const isOpen = dropdown.style.display === "block";
          if (!isOpen) {
            dropdown.style.display = "block";
            // Mark as read immediately when opened
            if (latestNotifId > 0) {
              localStorage.setItem('admin_last_read_id', latestNotifId);
              badge.style.display = "none";
              badge.textContent = "0";
            }
          } else {
            dropdown.style.display = "none";
          }
        });
        
        document.addEventListener("click", function() {
          dropdown.style.display = "none";
        });

        dropdown.style.addEventListener && dropdown.addEventListener("click", function(e) {
          e.stopPropagation();
        });

        // Load notifications from server API
        async function loadAdminNotifications() {
          try {
            const res = await fetch("/Admin/ActiveNotifications");
            if (!res.ok) return;
            const data = await res.json();
            
            // Only show DB notifications (where ID is positive) for the admin topbar
            const dbAlerts = data.filter(n => n.id > 0);
            
            if (dbAlerts.length > 0) {
              // Find max ID
              latestNotifId = Math.max(...dbAlerts.map(n => n.id));
              
              // Get last read ID from localStorage
              const lastReadId = parseInt(localStorage.getItem('admin_last_read_id') || '0');
              
              // Count unread alerts (IDs greater than last read ID)
              const unreadAlertsCount = dbAlerts.filter(n => n.id > lastReadId).length;
              
              // Only show badge if there are unread alerts AND dropdown is closed
              if (unreadAlertsCount > 0 && dropdown.style.display !== "block") {
                badge.style.display = "flex";
                badge.textContent = unreadAlertsCount;
              } else {
                badge.style.display = "none";
              }
              
              countText.textContent = `${dbAlerts.length} alert${dbAlerts.length !== 1 ? 's' : ''}`;
              
              listEl.innerHTML = dbAlerts.map(n => `
                <div style="padding: 10px 14px; border-bottom: 1px solid #f5f4f0; display: flex; gap: 10px; align-items: flex-start; transition: background 0.2s;" onmouseover="this.style.background='#faf9f7'" onmouseout="this.style.background=''">
                  ${n.imageUrl ? `<img src="/${n.imageUrl}" style="width: 28px; height: 34px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border); flex-shrink: 0;" />` : `<div style="width: 28px; height: 28px; border-radius: 50%; background: ${n.type === 'warning' ? 'rgba(192,57,43,0.1)' : 'rgba(201,169,110,0.1)'}; color: ${n.type === 'warning' ? 'var(--error)' : 'var(--gold)'}; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem;"><i class="fa-solid ${n.type === 'warning' ? 'fa-triangle-exclamation' : 'fa-info'}"></i></div>`}
                  <div style="flex: 1; min-width: 0;">
                    <div style="font-weight: 600; color: var(--ink); margin-bottom: 2px; font-size: 0.76rem;">${n.type === 'warning' ? 'Sold Out Alert' : 'Store Alert'}</div>
                    <div style="color: var(--ink-soft); font-size: 0.72rem; word-break: break-word;">${n.message}</div>
                  </div>
                </div>
              `).join('');
            } else {
              latestNotifId = 0;
              badge.style.display = "none";
              countText.textContent = "0 alerts";
              listEl.innerHTML = `
                <div style="padding: 24px; text-align: center; color: var(--mid); font-style: italic;">
                  No active store alerts.
                </div>
              `;
            }
          } catch(e) {}
        }
        
        loadAdminNotifications();
        // Poll every 30 seconds
        setInterval(loadAdminNotifications, 30000);
      }
    });
  </script>
  @await RenderSectionAsync("ExtraJs", required: false)
</body>
</html>
